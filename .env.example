# Copy this file to ".env" and fill in ONE provider. The ".env" file is gitignored.

# ---- Choose the brain: "anthropic" (Claude, default) or "google" (Gemini, free) ----
LLM_PROVIDER=anthropic

# ---- Option A: Claude (best quality; needs credit at console.anthropic.com) ----
ANTHROPIC_API_KEY=

# ---- Option B: Google Gemini (FREE tier, no credit card) ----
# Set LLM_PROVIDER=google above, then paste a free key from https://aistudio.google.com/apikey
GOOGLE_API_KEY=
# Optional: override the Gemini model (default: gemini-flash-latest)
# GOOGLE_MODEL=gemini-flash-latest
