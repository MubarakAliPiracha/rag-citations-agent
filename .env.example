# Copy to .env and fill in. Never commit the real .env.

# ─── Required ────────────────────────────────────────────────────────────────
# Free key, no credit card: https://aistudio.google.com/apikey
# Used for embeddings ALWAYS, and for chat when LLM_PROVIDER=google.
GOOGLE_API_KEY=

# ─── Optional ────────────────────────────────────────────────────────────────
# Which model writes the answers: "google" (default, free tier) or "anthropic".
# Whichever you pick must support tool calling — the agent is built on it.
LLM_PROVIDER=google

# Override the chat model. The default is gemini-flash-lite-latest, chosen because
# full Flash allows only 5 requests/minute on the free tier and one agent question
# can spend 2-4 of them.
# GOOGLE_MODEL=gemini-flash-lite-latest

# Only needed when LLM_PROVIDER=anthropic. https://console.anthropic.com
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-6

# Embedding settings. Changing either invalidates any index already built, so
# rebuild with `npm run build:index` afterwards.
# EMBEDDING_MODEL=gemini-embedding-001
# EMBEDDING_DIMS=768

# ─── Deployment only ─────────────────────────────────────────────────────────
# Vercel sets this automatically once a Blob store is attached to the project.
# It is what lets an uploaded PDF survive between the upload request and the
# question request. Leave it unset locally: uploads then cache to .cache/ on disk.
# BLOB_READ_WRITE_TOKEN=
